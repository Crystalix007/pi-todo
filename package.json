{
  "name": "pi-todo",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-optimized TODO-list planning for pi: hierarchical, named, SQLite3-persisted todo lists with a todo tool and /todo command.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "GPL-3.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "*",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  }
}
